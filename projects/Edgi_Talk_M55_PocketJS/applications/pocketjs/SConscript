# Edgi-Talk product PocketJS SCons.
#
# Prefer the monorepo host fragment when POCKETJS_ROOT points at a
# 1024971823/pocketjs (or pocket-nexus/pocketjs) clone that has
# hosts/rt-thread-edgitalk/native/SConscript. Fallback: full in-tree sources
# so this overlay still builds alone.
#
# Typical:
#   export POCKETJS_ROOT=/path/to/pocketjs
#   export POCKETJS_NATIVE_HOST_LOOP=0          # keep overlay pocketjs_app.c for now
#   export POCKETJS_NATIVE_PACKAGE_STUB=0       # use applications/pocketjs/generated/
#   export POCKETJS_QUICKJS_ROOT=/path/to/quickjs-ng   # optional

import os
from building import *

cwd = GetCurrentDir()
pocketjs_root = os.environ.get('POCKETJS_ROOT')
native_sc = None
if pocketjs_root:
    candidate = os.path.join(pocketjs_root, 'hosts/rt-thread-edgitalk/native/SConscript')
    if os.path.isfile(candidate):
        native_sc = candidate

bt_fw = os.path.abspath(cwd + '/../../../../libraries/components/bt-fw-ifx-cyw55500a1/COMPONENT_wlbga_iPA_sLNA_ANT0_LHL_XTAL_IN/btfw.c')

product_src = [
    cwd + '/pocketjs_dashboard.c',
    cwd + '/pocketjs_music.c',
    cwd + '/pocketjs_synth.c',
    cwd + '/pocketjs_game.c',
    cwd + '/pocketjs_wifi.c',
    cwd + '/pocketjs_bt.c',
    bt_fw,
    cwd + '/generated/pocketjs_package_edgitalk_smoke.c',
    cwd + '/generated/pocketjs_package_edgitalk_smoke_blob.S',
]

debug_flags = ' -DPOCKETJS_DEBUG_TOUCH' if os.environ.get('POCKETJS_DEBUG_TOUCH') else ''

if native_sc:
    # Shared stack + shims (+ optional host loop) from monorepo.
    # Default: keep overlay pocketjs_app.c until board hooks are bound.
    os.environ.setdefault('POCKETJS_NATIVE_HOST_LOOP', '0')
    os.environ.setdefault('POCKETJS_NATIVE_PACKAGE_STUB', '0')
    host_group, quickjs_group = SConscript(native_sc)

    product_src = [cwd + '/pocketjs_app.c'] + product_src
    product_path = [cwd + '/include', cwd + '/generated']
    product_group = DefineGroup(
        'PocketJSProduct',
        product_src,
        depend=[''],
        LOCAL_CPPPATH=product_path,
        LOCAL_CFLAGS=' -std=gnu11 -Wno-unused-function -Wno-unused-variable -Wno-format' +
                     debug_flags,
    )
    AlwaysBuild(cwd + '/generated/pocketjs_package_edgitalk_smoke_blob.o')
    Return('host_group', 'quickjs_group', 'product_group')

# ---- Fallback: full in-tree build (no POCKETJS_ROOT) ----
repo_root = os.path.abspath(cwd + '/../../../../../pocketjs')
quickjs_root = os.environ.get(
    'POCKETJS_QUICKJS_ROOT',
    os.path.abspath(cwd + '/../../../../../quickjs-ng'))

idf_root = repo_root + '/hosts/esp-idf/components'
rust_lib_dir = repo_root + '/hosts/esp-idf/native/ui-core/target/thumbv8m.main-none-eabihf/release'
renderer_rust_lib_dir = repo_root + '/hosts/esp-idf/native/render-rgb565/target/thumbv8m.main-none-eabihf/release'
smoke_package = repo_root + '/apps/edgitalk-m55-smoke/dist/edgitalk-m55-smoke.pocket'

host_src = [
    cwd + '/pocketjs_app.c',
    cwd + '/pocketjs_dashboard.c',
    cwd + '/pocketjs_music.c',
    cwd + '/pocketjs_synth.c',
    cwd + '/pocketjs_game.c',
    cwd + '/pocketjs_wifi.c',
    cwd + '/pocketjs_bt.c',
    bt_fw,
    cwd + '/pocketjs_rt_compat.c',
    cwd + '/quickjs_compat.c',
    cwd + '/generated/pocketjs_package_edgitalk_smoke.c',
    cwd + '/generated/pocketjs_package_edgitalk_smoke_blob.S',
    idf_root + '/pocketjs_guest/src/guest.c',
    idf_root + '/pocketjs_package/src/package.c',
    idf_root + '/pocketjs_ui_qjs/src/ui_qjs.c',
    idf_root + '/pocketjs_ui_core/src/ui_core.c',
    idf_root + '/pocketjs_render_rgb565/src/render_rgb565.c',
]

quickjs_src = [
    quickjs_root + '/quickjs.c',
    quickjs_root + '/libregexp.c',
    quickjs_root + '/libunicode.c',
    quickjs_root + '/dtoa.c',
]

path = [
    cwd + '/include',
    cwd + '/generated',
    quickjs_root,
    idf_root + '/pocketjs_guest/include',
    idf_root + '/pocketjs_package/include',
    idf_root + '/pocketjs_ui_qjs/include',
    idf_root + '/pocketjs_ui_core/include',
    idf_root + '/pocketjs_render_rgb565/include',
]

host_group = DefineGroup(
    'PocketJS',
    host_src,
    depend=[''],
    LOCAL_CPPPATH=path,
    LOCAL_CFLAGS=' -std=gnu11 -Wno-unused-function -Wno-unused-variable -Wno-format -include ' +
                 cwd + '/include/pocketjs_qjs_ng_compat.h' + debug_flags,
    LIBPATH=[renderer_rust_lib_dir, rust_lib_dir],
    LIBS=['pocketjs_idf_render_rgb565', 'pocketjs_idf_ui_core'],
)

AlwaysBuild(cwd + '/generated/pocketjs_package_edgitalk_smoke_blob.o')
Depends(host_group, smoke_package)

quickjs_group = DefineGroup(
    'PocketJSQuickJS',
    quickjs_src,
    depend=[''],
    LOCAL_CPPPATH=[quickjs_root],
    LOCAL_CPPDEFINES=[
        'EMSCRIPTEN',
        'alloca=__builtin_alloca',
        'CONFIG_VERSION="edgitalk-m55"',
    ],
    LOCAL_CFLAGS=' -std=gnu11 -Wno-unused-function -Wno-unused-variable -Wno-format -include ' +
                 cwd + '/include/quickjs_platform.h',
)

Return('host_group', 'quickjs_group')
